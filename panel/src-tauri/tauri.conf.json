{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Copilot",
  "version": "0.1.0",
  "identifier": "dev.meeting-copilot.panel",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Copilot",
        "width": 380,
        "height": 660,
        "minWidth": 300,
        "minHeight": 60,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": true,
        "skipTaskbar": true,
        "transparent": true,
        "x": 40,
        "y": 80
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
